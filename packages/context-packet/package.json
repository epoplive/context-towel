{
  "name": "@context-towel/context-packet",
  "version": "0.0.1",
  "description": "Markdown-first context packet system — AI scratch paper with diagrams and pattern-driven workflows",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "packet": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "src/commands"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js",
      "require": "./dist/engine.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "engine": ["./dist/engine.d.ts"]
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@context-towel/card-library": "*",
    "@context-towel/core": "*",
    "@mikro-orm/core": "^6.6.6",
    "@mikro-orm/sqlite": "^6.6.6",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
