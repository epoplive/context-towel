    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    },
    "./channel": {
      "types": "./dist/channel.d.ts",
      "import": "./dist/channel.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./compat/services": {
      "types": "./dist/compat/services.d.ts",
      "import": "./dist/compat/services.js"
    },
    "./compat/windowStorage": {
      "types": "./dist/compat/windowStorage.d.ts",
      "import": "./dist/compat/windowStorage.js"
    },
    "./compat/keybindings": {
      "types": "./dist/compat/keybindings.d.ts",
      "import": "./dist/compat/keybindings.js"
    },
    "./compat/design-system": {
      "types": "./dist/compat/design-system.d.ts",
