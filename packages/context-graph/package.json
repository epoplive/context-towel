{
  "name": "@context-towel/context-graph",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./graph": {
      "import": "./src/graph-index.ts"
    },
    "./compat/services": {
      "import": "./src/compat/services.ts"
    },
    "./compat/windowStorage": {
      "import": "./src/compat/windowStorage.ts"
    },
    "./compat/keybindings": {
      "import": "./src/compat/keybindings.ts"
    },
    "./compat/design-system": {
      "import": "./src/compat/design-system/index.ts"
    },
    "./plugins/task/idFixer": {
      "import": "./src/plugins/task/idFixer.ts"
    },
    "./plugins/task/types": {
      "import": "./src/plugins/task/types.ts"
    },
    "./embed": {
      "import": "./src/embed.ts"
    },
    "./components/*": {
      "import": "./src/components/*"
    },
    "./state/*": {
      "import": "./src/state/*"
    },
    "./compat/*": {
      "import": "./src/compat/*"
    },
    "./hooks/*": {
      "import": "./src/hooks/*"
    },
    "./plugins": {
      "import": "./src/plugins/index.ts"
    },
    "./plugins/*": {
      "import": "./src/plugins/*"
    },
    "./channel": {
      "import": "./src/channel.ts"
    },
    "./types": {
      "import": "./src/types.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsup src/index.ts src/embed.ts --format esm --dts --clean --outDir dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "@context-towel/card-library": "*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.0.0",
    "dagre": "^0.8.5",
    "emoji-dictionary": "^1.0.12",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.28",
    "lucide-react": "^0.563.0",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.52",
    "@types/node": "^25.2.1",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
