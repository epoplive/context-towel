{
  "name": "@context-towel/context-graph",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./embed": {
      "import": "./dist/embed.js",
      "types": "./dist/embed.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsup src/index.ts src/embed.ts --format esm --dts --clean --outDir dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "@context-towel/card-library": "*",
    "@xyflow/react": "^12.0.0",
    "dagre": "^0.8.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.52",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
