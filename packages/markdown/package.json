{
  "name": "@context-towel/markdown",
  "version": "0.0.5",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --outDir dist",
    "dev": "tsup src/index.ts --format esm --dts --sourcemap --watch --outDir dist",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@context-towel/card-library": "^0.0.3",
    "@types/mdast": "^4.0.2",
    "emoji-dictionary": "^1.0.12",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.28",
    "mermaid": "^11.12.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
